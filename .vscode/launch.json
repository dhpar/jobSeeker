{
  "configurations": [
    {
      "name": "Containers: Python - FastAPI",
      "type": "docker",
      "request": "launch",
      "preLaunchTask": "Compose build",
      "python": {
        "pathMappings": [
          {
            "localRoot": "${workspaceFolder}/app",
            "remoteRoot": "/app",
          }
        ],
        "port": 8888,
      },
      "dockerServerReadyAction": {
        "action": "openExternally",
        "pattern": "Starting development server at (https?://\\S+|[0-9]+)",
        "uriFormat": "%s://localhost:%s/docs",
      }
    }
  ]
}
