{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: API (uvicorn --reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.app:app", "--reload", "--port", "8888"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      "name": "Backend: full (run.py: scrape + serve)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      "name": "Frontend: Chrome (debug)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "frontend: dev"
    }
  ],
  "compounds": [
    {
      "name": "Full stack: backend + frontend",
      "configurations": ["Backend: API (uvicorn --reload)", "Frontend: Chrome (debug)"],
      "stopAll": true
    }
  ]
}
