{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "type": "docker-compose",
            "label": "Compose build",
            "dockerCompose": {
                "up": {
                    "detached": true,
                    "build": true,

                },

                "files": [
                    "${workspaceFolder}/compose.yml"
                ]

            }
        },
        {
            "type": "docker-run",
            "label": "docker-run: debug",
            "dependsOn": [
                "docker-build"
            ],
            "dockerRun": {
                "containerPath": "/app", 
                "localPath": "${workspaceFolder}/app"
            },
            "python": {
                "args": ["app.app:app", "--host", "0.0.0.0", "--port", "8888"],
                "module": "uvicorn",
            }
            
        }
    ]
}